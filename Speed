print("HALO + SPEED")

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local pg = LocalPlayer:WaitForChild("PlayerGui")

-- Hapus lama
if pg:FindFirstChild("TesMini") then
    pg.TesMini:Destroy()
end

local gui = Instance.new("ScreenGui")
gui.Name = "TesMini"
gui.ResetOnSpawn = false
gui.Parent = pg

-- Label status
local label = Instance.new("TextLabel")
label.Size = UDim2.new(0, 220, 0, 50)
label.Position = UDim2.new(0.5, -110, 0.25, 0)
label.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
label.Text = "SCRIPT + SPEED"
label.TextColor3 = Color3.fromRGB(0, 255, 0)
label.TextScaled = true
label.Font = Enum.Font.GothamBold
label.Parent = gui

-- Tombol Speed
local btn = Instance.new("TextButton")
btn.Size = UDim2.new(0, 150, 0, 45)
btn.Position = UDim2.new(0.5, -75, 0.4, 0)
btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
btn.Text = "Speed: OFF"
btn.TextColor3 = Color3.fromRGB(255, 80, 80)
btn.Font = Enum.Font.GothamBold
btn.TextSize = 16
btn.Parent = gui
Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

local speedOn = false

btn.MouseButton1Click:Connect(function()
    speedOn = not speedOn
    if speedOn then
        btn.Text = "Speed: ON"
        btn.TextColor3 = Color3.fromRGB(80, 255, 80)
    else
        btn.Text = "Speed: OFF"
        btn.TextColor3 = Color3.fromRGB(255, 80, 80)
    end
end)

-- Loop Speed
RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        if speedOn then
            char.Humanoid.WalkSpeed = 50
        else
            char.Humanoid.WalkSpeed = 16
        end
    end
end)

print("Speed siap")
